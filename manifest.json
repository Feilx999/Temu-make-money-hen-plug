{
  "manifest_version": 3,
  "name": "TEMU印钞鸡",
  "version": "1.3",
  "description": "TEMU自动托管工具，自动开JIT、自动补货、自动合规、自动核价、自动报活动、自动确认、自动开广告",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "alarms",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["replenishWorker.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}